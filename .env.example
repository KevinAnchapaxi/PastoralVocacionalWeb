# Copia este archivo como .env.local y completa los valores.
# Las variables NEXT_PUBLIC_* se incrustan en la compilación y son visibles en el navegador:
# nunca pongas aquí claves secretas.

# Nombre de la cuenta (cloud name) de Cloudinary. Solo es obligatorio si en
# src/data/landing.ts se usan IDs públicos ("pastoral/retiro") en vez de URLs completas.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
