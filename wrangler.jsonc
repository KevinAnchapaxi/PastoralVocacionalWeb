// Publicación en Cloudflare Workers como sitio estático (ver docs/infraestructura.md).
// `npm run build` genera out/ y `npx wrangler deploy` lo sube. No hay código de servidor.
{
  // Debe coincidir con el nombre del Worker en el panel de Cloudflare.
  "name": "pastoralvocacionalweb",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    // Rutas inexistentes muestran out/404.html con estado 404.
    "not_found_handling": "404-page"
  }
}
